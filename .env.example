# Supabase (Project Settings > API) ใช้ฝั่ง server เท่านั้น ห้ามใส่ prefix NEXT_PUBLIC_
SUPABASE_URL=https://<project-ref>.supabase.co
# service role key ข้าม RLS ได้ทั้งหมด เก็บใน .env เท่านั้น ห้าม commit
SUPABASE_SERVICE_ROLE_KEY=

# ---- ไม่ใช้แล้ว (สมัย Prisma) เก็บไว้ให้ psql / Supabase CLI ต่อ DB ตรงได้ ----
# แบบ local (docker compose up -d):
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/salesync
# DATABASE_URL ของ Supabase ใส่ใน .env เท่านั้น (ดูตัวอย่างด้านล่าง)

# แบบ Supabase (Project Settings > Database > Connect):
# DATABASE_URL = app runtime ใช้ Transaction pooler (:6543)
# DIRECT_URL   = psql / supabase CLI ใช้ Session pooler (:5432) หรือ Direct connection
# sslrootcert = CA ที่โหลดจากหน้า Database Settings > SSL Configuration (เป็น public cert, commit ได้)
#DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=verify-full&sslrootcert=./prisma/supabase-ca.crt
#DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=./prisma/supabase-ca.crt

# true = ไม่ยิง Odoo จริง เหมาะสำหรับลอง UI/Flow ก่อน
ODOO_MOCK=false

# ใช้เมื่อ ODOO_MOCK=false
#ODOO_URL=http://localhost:40019
#ODOO_DB=go-along
#ODOO_USERNAME=your_odoo_login
#ODOO_API_KEY=your_api_key


ODOO_URL=https://12buy-shop.odoo.com
ODOO_DB=12buy-shop
ODOO_USERNAME=your_odoo_login
ODOO_API_KEY=your_api_key




# Optional
ODOO_AUTO_CONFIRM=true

# true (default) = block every write to Odoo (create/write/unlink/action_*). Set false only when sync is intended.
ODOO_READ_ONLY=true

# URL สาธารณะของเว็บ ใช้สร้าง canonical / sitemap / OG image (ไม่มี slash ท้าย)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: JSON webhook that receives new dealer sign-ups from the landing form (LINE relay, Make, Zapier ...)
LEAD_WEBHOOK_URL=

# Show demo "advance status" buttons in /shop for back-office users. Never set on production.
SHOP_DEMO_CONTROLS=false

# Secret for POST /api/cron/odoo-status (Authorization: Bearer <secret>), at least 16 characters.
CRON_SECRET=
