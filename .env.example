# Supabase (Project Settings > API) ใช้ฝั่ง server เท่านั้น ห้ามใส่ prefix NEXT_PUBLIC_
SUPABASE_URL=https://<project-ref>.supabase.co
# service role key ข้าม RLS ได้ทั้งหมด เก็บใน .env เท่านั้น ห้าม commit
SUPABASE_SERVICE_ROLE_KEY=

# Odoo connection (JSON-RPC). Can also be set from /admin/settings (stored encrypted); these are the fallback.
ODOO_URL=https://<your-company>.odoo.com
ODOO_DB=<database-name>
ODOO_USERNAME=<odoo-login-email>
ODOO_API_KEY=<odoo-api-key>

# Legacy demo pages only: true = use built-in mock data instead of Odoo (never on production).
ODOO_MOCK=false

# true (default) = block every write to Odoo (create/write/action_*). Set false ONLY on the deployment
# that is meant to push orders / pricelists into Odoo (production, or staging pointed at a staging Odoo).
ODOO_READ_ONLY=true

# Product (service) "ส่วนลดเงินสด" in Odoo: the cash discount goes on the SO as end-of-bill lines with it.
# Empty = the discount is folded into each line's price_unit instead.
#ODOO_CASH_DISCOUNT_PRODUCT_ID=

# URL สาธารณะของเว็บ ใช้สร้าง canonical / sitemap / OG image (ไม่มี slash ท้าย)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: JSON webhook that receives new dealer sign-ups from the landing form (LINE relay, Make, Zapier ...)
LEAD_WEBHOOK_URL=

# Show demo "advance status" buttons in /shop for back-office users. Never set on production.
SHOP_DEMO_CONTROLS=false

# Secret for POST /api/cron/odoo-status (Authorization: Bearer <secret>), at least 16 characters.
CRON_SECRET=

# Cloudflare Turnstile (bot check on dealer sign-up). Create a widget at dash.cloudflare.com > Turnstile.
# Local testing: site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA (always pass).
# Production refuses sign-ups when TURNSTILE_SECRET_KEY is missing.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Encrypts secrets saved from /admin/settings (e.g. the Odoo API key). Any long random string (32+ chars).
# Without it a key derived from SUPABASE_SERVICE_ROLE_KEY is used; rotating that key then invalidates saved secrets.
SETTINGS_SECRET=

# Error monitoring (Sentry). Leave empty to run without it. Server + browser DSN are usually the same value.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Only for CI builds that upload source maps.
#SENTRY_AUTH_TOKEN=
#SENTRY_ORG=
#SENTRY_PROJECT=

# Structured log floor: debug | info | warn | error (default info on production, debug elsewhere).
#LOG_LEVEL=info

# Set to true once the Content-Security-Policy report-only phase shows no violations.
#CSP_ENFORCE=false
